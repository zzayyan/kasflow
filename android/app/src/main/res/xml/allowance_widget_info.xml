<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is the floor Android allows; it turns the figure over after midnight.
     ponytail: up to 30 min late after midnight; a midnight alarm if that ever matters. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/allowance_widget"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:previewLayout="@layout/allowance_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
